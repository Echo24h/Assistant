# Copy to .env (never commit .env) and set file permissions to 600.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_FAST_MODEL=claude-haiku-5-5
ASSISTANT_EFFORT=low
ASSISTANT_TIMEZONE=Europe/Zurich
ASSISTANT_DATA_DIR=~/.local/share/assistant
# Google Calendar (optional): OAuth client of type "Desktop app", see README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
