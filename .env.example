# Copy to .env (never commit .env) and set file permissions to 600.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_FAST_MODEL=claude-haiku-5-5
ASSISTANT_EFFORT=low
ASSISTANT_TIMEZONE=Europe/Zurich
ASSISTANT_LANGUAGE=French
ASSISTANT_CURRENCY=CHF
ASSISTANT_DATA_DIR=~/.local/share/assistant
# Google Calendar and Gmail (optional): one OAuth client of type "Desktop app"
# for both services, see README. Then run: python -m assistant login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web interface for the phone (python -m assistant web), through Tailscale.
# The household: allowed Tailscale logins, as login=name, comma-separated.
# The FIRST one is the owner (their Google accounts, the terminal acts as them).
ASSISTANT_WEB_USERS=
ASSISTANT_WEB_PORT=8765
# Local tests only, without Tailscale: act as this login. Never on a server.
ASSISTANT_WEB_DEV_USER=
